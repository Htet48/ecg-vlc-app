  "revision_notes": {
    "version": "v4.0 \u2014 ACO-OFDM corrected (N/4=64 independent subcarriers, 68 frames)",
    "changes": [
      "FIXED: LED cubic coefficient sign: a3=-0.02 (compression, not expansion)",
      "FIXED: State-dependent direct/diffuse path weights (\u03b7_dir, \u03b7_diff)",
      "REVISED: \u03c4_eff reframed as effective signal-level memory, not optical propagation delay",
      "REVISED: H0 described as normalized geometric gain factor, not calibrated link budget",
      "CORRECTED: ACO-OFDM independent subcarrier count: N/4=64 per frame (not N/2=128); frame count 68 (not 34)",
      "CLARIFIED: h_eff formula exp(-t_k/tau_eff) where t_k=k/fs and tau_eff=0.015 s (15 ms); both old and new formulas were algebraically identical -- BER increase was due to LED sign fix and state weights, not h_eff",
      "ADDED: Sensitivity analysis (low/nominal/severe ambient/occlusion scenarios)",
      "ADDED: Threshold sensitivity utility for IMU percentile perturbation",
      "REVISED: State labels \u2192 LoS-dominant, partially-obstructed, diffuse-dominant",
      "REVISED: BER explicitly described as uncoded/raw BER after ACO-OFDM demodulation",
      "REVISED: SQ-SNR uses single summation-based definition throughout",
      "CLARIFIED: ACO-OFDM frame padding (68 frames, last zero-padded by 32 symbols)"
    ]
  },
  "channel_model": {
    "scope": "IMU-informed motion-conditioned surrogate channel model",
    "NOT": "Hardware-calibrated optical channel model",
    "C1_state_attenuation": "State-dependent effective attenuation from IMU motion",
    "C2_jitter": "Log-normal jitter, \u03c3 learned from gyro stability",
    "C3_lambertian": "H0 = normalized geometric gain factor (\u22481.0)",
    "C4_direct_path": "\u03b7_dir[state] \u00d7 H0 \u00d7 g(a_t) \u00d7 \u03be(t) \u00d7 s(t)",
    "C5_diffuse_path": "\u03b7_diff[state] \u00d7 \u03b2 \u00d7 h_eff(t) * s(t); \u03c4_eff=15ms is effective memory, not propagation delay",
    "C6_combination": "State-dependent weighted sum of direct + diffuse",
    "C7_led_nonlinearity": "a1\u00d7s + a3\u00d7s\u00b3 (a3=-0.02, compression); hard clip at Pmax=1.2",
    "C8_noise": "Bright: \u03c3_th=0.0015, \u03c3_sh=0.0025 (simulation-domain effective)",
    "state_weights": {
      "LoS-dominant (0)": {
